#!/usr/bin/python3
"""Desktop launcher for the static WASM Player build.

Serves the bundled web app on loopback with COOP/COEP and opens it in a
dedicated Chromium app window. No network service is exposed beyond 127.0.0.1.
"""
from __future__ import annotations

import argparse
import http.server
import os
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.parse
from pathlib import Path

APP_NAME = "WASM Player"
SCRIPT_DIR = Path(__file__).resolve().parent
DEFAULT_ROOT = SCRIPT_DIR / "web"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "wasm-player"
LOG_FILE = STATE_DIR / "launcher.log"


class Handler(http.server.SimpleHTTPRequestHandler):
    extensions_map = {
        **http.server.SimpleHTTPRequestHandler.extensions_map,
        ".wasm": "application/wasm",
        ".mjs": "text/javascript",
        ".js": "text/javascript",
        ".svg": "image/svg+xml",
    }

    def end_headers(self) -> None:
        self.send_header("Cross-Origin-Opener-Policy", "same-origin")
        self.send_header("Cross-Origin-Embedder-Policy", "require-corp")
        self.send_header("Cross-Origin-Resource-Policy", "same-origin")
        self.send_header("Cache-Control", "no-cache")
        super().end_headers()

    def do_GET(self) -> None:
        path = urllib.parse.urlsplit(self.path).path
        if path == "/api/bootstrap":
            # The static package has no Companion; the UI treats this as offline.
            self.send_response(204)
            self.end_headers()
            return
        if path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
            return
        super().do_GET()

    def log_message(self, fmt: str, *args: object) -> None:
        # Keep the journal clean; launcher errors are written to launcher.log.
        return


def show_error(message: str) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOG_FILE.open("a", encoding="utf-8") as log:
        log.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")
    for command in (("zenity", "--error", "--title", APP_NAME, "--text", message),
                     ("kdialog", "--error", message)):
        if shutil.which(command[0]):
            try:
                subprocess.run(command, check=False)
                return
            except OSError:
                pass
    print(message, file=sys.stderr)


def find_browser() -> str | None:
    explicit = os.environ.get("WASM_PLAYER_BROWSER")
    if explicit:
        return explicit if os.path.isabs(explicit) or shutil.which(explicit) else None
    for name in (
        "google-chrome-stable",
        "google-chrome",
        "chromium",
        "chromium-browser",
        "microsoft-edge-stable",
        "microsoft-edge",
    ):
        path = shutil.which(name)
        if path:
            return path
    return None


def make_server(root: Path) -> tuple[http.server.ThreadingHTTPServer, str]:
    if not (root / "index.html").is_file():
        raise RuntimeError(f"web build not found at {root / 'index.html'}")
    handler = lambda *args, **kwargs: Handler(*args, directory=str(root), **kwargs)  # noqa: E731
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)
    server.daemon_threads = True
    return server, f"http://127.0.0.1:{server.server_port}/"


def serve_forever(server: http.server.ThreadingHTTPServer) -> None:
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main() -> int:
    parser = argparse.ArgumentParser(description=APP_NAME)
    parser.add_argument("--serve", action="store_true", help="serve only; do not open a browser")
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT, help="directory containing index.html")
    args = parser.parse_args()

    root = args.root.expanduser().resolve()
    try:
        server, url = make_server(root)
    except Exception as error:  # pragma: no cover - desktop error path
        show_error(f"{APP_NAME} could not start: {error}")
        return 2

    if args.serve:
        print(url, flush=True)
        serve_forever(server)
        return 0

    browser = find_browser()
    if not browser:
        server.server_close()
        show_error("Chrome/Chromium/Microsoft Edge was not found. Install one of them and try again.")
        return 3

    profile = STATE_DIR / "chrome-profile"
    profile.mkdir(parents=True, exist_ok=True)
    thread = threading.Thread(target=serve_forever, args=(server,), daemon=True)
    thread.start()

    command = [
        browser,
        f"--app={url}",
        f"--user-data-dir={profile}",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-background-mode",
        "--disable-session-crashed-bubble",
        "--disable-features=Translate,MediaRouter,OptimizationHints",
        "--password-store=basic",
        "--class=WasmPlayer",
        "--window-size=1280,860",
    ]
    try:
        subprocess.run(command, check=False)
    except OSError as error:
        show_error(f"{APP_NAME} could not launch the browser: {error}")
        return 4
    finally:
        server.shutdown()
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
